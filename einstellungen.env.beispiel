# Einstellungen von Kompass – als «einstellungen.env» speichern, Werte eintragen,
# danach den Container neu erstellen (Docker liest die Datei nur beim Erstellen).

# ---------- Anmeldung (Pflicht) ----------
# Passwort, mindestens 16 Zeichen. Ohne gültiges Passwort bleibt die App gesperrt.
# Tipp: mehrere zufällige Wörter, z. B. «Segel-Feige-Bruecke-Komet-47». Nicht dasselbe wie bei Hörwerk.
APP_PASSWORD=

# ---------- KI (Claude) ----------
# Für Reisepläne, Zielvorschläge, Foto-Übersetzung und Nachrichten-Entwürfe.
# Schlüssel: https://platform.claude.com → API Keys (dort auch ein Ausgabenlimit setzen).
# Kann auch später in der App eingetragen werden (Profil → Einstellungen → Claude-Schlüssel).
ANTHROPIC_API_KEY=

# Kostenbremse: so viel USD dürfen KI-Aufrufe in 24 Stunden höchstens kosten.
DAILY_BUDGET_USD=3

# Optional (lassen sich auch in der App umstellen):
# MODEL=claude-opus-5-5        (günstiger: claude-sonnet-5-5 oder claude-haiku-5-5)
# CHECK_TIME=06:30             (Wettercheck jeden Morgen, Ortszeit am Reiseziel)
# HOME_AIRPORT=ZRH
