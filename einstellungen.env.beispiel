# Einstellungen von Kompass – als «einstellungen.env» speichern, Werte eintragen,
# danach den Container neu erstellen (Docker liest die Datei nur beim Erstellen).

# Passwort für die Anmeldung, mindestens 16 Zeichen. Ohne gültiges Passwort bleibt die App gesperrt.
# Tipp: mehrere zufällige Wörter, z. B. «Segel-Feige-Brücke-Komet-47». Nicht dasselbe wie bei Hörwerk.
APP_PASSWORD=
